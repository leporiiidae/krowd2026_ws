Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /LiDAR (Held While Paused)1
        - /Classified Cones1
        - /Search Sectors1
        - /Pure Pursuit Path1
        - /Pure Pursuit Lookahead1
      Splitter Ratio: 0.55
    Tree Height: 620
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: base_link
      Value: true
    - Alpha: 0.22
      Class: rviz_default_plugins/PointCloud2
      Color: 145; 145; 145
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR (Held While Paused)
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.029999999329447746
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stop_mission/held_points
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Classified Cones
      Namespaces:
        blue: true
        yellow: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stop_mission/cones
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Virtual Cones
      Namespaces:
        virtual_blue: true
        virtual_yellow: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stop_mission/virtual_cones
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Search Sectors
      Namespaces:
        blue_search_outline: true
        yellow_search_outline: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stop_mission/search_sectors
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 80
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.30000001192092896
      Line Style: Billboards
      Line Width: 0.07999999821186066
      Name: Pure Pursuit Path
      Offset:
        X: 0
        Y: 0
        Z: 0.07999999821186066
      Pose Color: 0; 255; 80
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stop_mission/path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Pure Pursuit Lookahead
      Namespaces:
        pure_pursuit_lookahead: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stop_mission/lookahead_marker
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1
      Name: Vehicle Origin
      Radius: 0.080000000000000002
      Reference Frame: base_link
      Value: true
  Enabled: true
  Global Options:
    Background Color: 28; 28; 32
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 8
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Stop Mission Orbit
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.550000011920929
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 1.5707963267948966
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 50
